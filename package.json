{
  "name": "briefly",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "24.15.0",
    "pnpm": "10.30.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "Briefly's D1 database for the administrator, settings, drafts, and publication history."
      },
      "MEDIA_BUCKET": {
        "description": "Briefly's private R2 bucket for uploaded media."
      },
      "BETTER_AUTH_SECRET": {
        "description": "Generate a permanent random value of at least 32 characters. Do not reuse SETUP_SECRET."
      },
      "SETUP_SECRET": {
        "description": "Generate a different random value of at least 32 characters, then paste it into Briefly's First-run setup page."
      }
    }
  },
  "scripts": {
    "paraglide:compile": "node --experimental-strip-types ./scripts/compile-paraglide.mjs",
    "dev": "CLOUDFLARE_ENV=local vite dev",
    "build": "vite build && node scripts/verify-client-boundary.mjs",
    "build:production": "CLOUDFLARE_ENV=production vite build && node scripts/verify-client-boundary.mjs",
    "preview": "vite preview",
    "typecheck": "pnpm paraglide:compile && tsc --noEmit && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p playwright/tsconfig.json",
    "test": "pnpm paraglide:compile && vitest run",
    "test:e2e": "playwright test",
    "test:e2e:server": "node scripts/playwright-server.mjs",
    "test:watch": "vitest",
    "prototype:renderer:bundle": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.output/publication-renderer-prototype/wrangler.log wrangler deploy --dry-run --config prototype/publication-renderer/wrangler.jsonc --outfile .output/publication-renderer-prototype/worker.js --metafile .output/publication-renderer-prototype/bundle-meta.json",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "node scripts/validate-release-workflows.mjs",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:deploy": "wrangler d1 migrations apply DB --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --env production --remote",
    "deploy": "pnpm db:migrate:deploy && wrangler deploy",
    "deploy:worker": "wrangler deploy --env production",
    "smoke:production": "node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "@elysiajs/eden": "1.4.9",
    "@heroui/react": "3.2.2",
    "@inlang/paraglide-js": "2.23.1",
    "@jsquash/avif": "2.1.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/webp": "1.5.0",
    "@sinclair/typebox": "0.34.52",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-code-block": "3.29.2",
    "@tiptap/extension-link": "3.29.2",
    "@tiptap/extension-list": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "@tiptap/static-renderer": "3.29.2",
    "better-auth": "1.6.25",
    "drizzle-orm": "0.45.2",
    "elysia": "1.4.29",
    "openapi-types": "12.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@inlang/plugin-message-format": "4.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "drizzle-kit": "0.31.10",
    "js-yaml": "4.3.0",
    "playwright": "1.61.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  }
}
